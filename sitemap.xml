---
layout: null
sitemap: false
---
<?xml version="1.0" encoding="UTF-8"?>
{%- comment -%}
  Hand-rolled sitemap. jekyll-polyglot renders each page once per language, so both
  variants are emitted from a single language-neutral page url, with xhtml:link
  alternates pointing at each other (same pairing as the hreflang tags in head.html).
{%- endcomment -%}
{%- assign default_lang = site.default_lang | default: "zh" -%}
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9"
        xmlns:xhtml="http://www.w3.org/1999/xhtml">
{%- for p in site.pages -%}
{%- assign path = p.url | remove_first: 'index.html' | remove: '.html' -%}
{%- if path == '' -%}{%- assign path = '/' -%}{%- endif -%}
{%- unless p.url contains '404' or p.url contains '.xml' or p.url contains '.txt' or p.noindex -%}
  <url>
    <loc>{{ path | absolute_url }}</loc>
    <lastmod>{{ site.time | date_to_xmlschema }}</lastmod>
    <xhtml:link rel="alternate" hreflang="zh-CN" href="{{ path | absolute_url }}"/>
    <xhtml:link rel="alternate" hreflang="en" href="{{ '/en' | append: path | absolute_url }}"/>
    <xhtml:link rel="alternate" hreflang="x-default" href="{{ path | absolute_url }}"/>
  </url>
  <url>
    <loc>{{ '/en' | append: path | absolute_url }}</loc>
    <lastmod>{{ site.time | date_to_xmlschema }}</lastmod>
    <xhtml:link rel="alternate" hreflang="zh-CN" href="{{ path | absolute_url }}"/>
    <xhtml:link rel="alternate" hreflang="en" href="{{ '/en' | append: path | absolute_url }}"/>
    <xhtml:link rel="alternate" hreflang="x-default" href="{{ path | absolute_url }}"/>
  </url>
{%- endunless -%}
{%- endfor %}
</urlset>
